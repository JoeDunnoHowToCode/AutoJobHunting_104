{
  "name": "auto-job-hunter",
  "version": "1.0.0",
  "description": "Automated 104 job bank application assistant using Playwright and Gemini",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "dry-run": "ts-node src/index.ts --dry-run",
    "dry-run:headed": "cross-env AUTOJOB_HEADLESS=false ts-node src/index.ts --dry-run",
    "dry-run:review": "cross-env AUTOJOB_HEADLESS=false ts-node src/index.ts --dry-run --pause-before-close",
    "diagnose-104:headed": "cross-env AUTOJOB_HEADLESS=false ts-node src/diagnose-104.ts",
    "diagnose-104:job": "cross-env AUTOJOB_HEADLESS=false ts-node src/diagnose-104.ts --job-id",
    "preflight-104:review": "cross-env AUTOJOB_HEADLESS=false ts-node src/preflight-104.ts --job-id",
    "inspect-apply": "cross-env AUTOJOB_HEADLESS=false ts-node src/inspect-application.ts",
    "login": "ts-node src/login.ts",
    "test": "vitest run",
    "test:ai": "npm run test-ai && npm run test-cover-letter",
    "test-ai": "ts-node tests/ai-smoke.ts",
    "test-cover-letter": "ts-node tests/cover-letter-test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "latest",
    "@notionhq/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "openai": "^7.4.0",
    "p-queue": "^6.6.2",
    "playwright": "^1.44.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.12.12",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  }
}
