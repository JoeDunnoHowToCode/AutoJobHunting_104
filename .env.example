# ==========================================
# 隱私金鑰與密碼設定檔 (.env)
# 請將此檔案命名為 .env，絕對不要上傳到公開的 GitHub
# 專案的其他一般設定（如投遞上限、分數門檻）請至 settings.json 調整
# ==========================================

# Google Gemini API 金鑰 (請至 https://aistudio.google.com/ 取得)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Telegram 通知 Bot Token (請找 @BotFather 取得)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# 請先發送訊息給您的 Bot，系統啟動時會自動抓取 Chat ID，或者您也可以手動填寫
TELEGRAM_CHAT_ID=

# Notion 紀錄資料庫
NOTION_API_TOKEN=YOUR_NOTION_INTEGRATION_TOKEN
NOTION_DATABASE_ID=YOUR_NOTION_DATABASE_ID
